        <div style="font-size:13px;color:#86868b;margin-top:2px;">Apple Inc.</div>
      </td>
      <td style="padding:14px 0;border-bottom:1px solid #2a2a2e;text-align:right;font-variant-numeric:tabular-nums;">
        <div style="font-size:17px;font-weight:600;color:#f5f5f7;">$268.01</div>
